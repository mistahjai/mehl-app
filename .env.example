# Copy to .env and adjust. .env is gitignored — never commit real values.

# Where market.duckdb / mehl.db live. In Docker this is the bind-mounted ./backend/data.
# MEHL_DATA_DIR=/app/data

# Extra port bind for the frontend container, e.g. your Tailscale IP.
# Defaults to 127.0.0.1 (localhost only). Leave unset to avoid exposing the app.
# MEHL_BIND_IP=100.x.y.z

# Daily market-data refresh (UTC). Default 17:30 UTC = 23:00 IST.
# MEHL_DATA_UPDATE_ENABLED=true
# MEHL_DATA_UPDATE_HOUR=17
# MEHL_DATA_UPDATE_MINUTE=30

# Comma-separated extra browser origins allowed to call the API.
# MEHL_CORS_ORIGINS=["http://localhost:5173"]
